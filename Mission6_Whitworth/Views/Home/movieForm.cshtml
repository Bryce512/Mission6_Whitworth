@model Movie

<h1 class="display-4">Add a New Movie</h1>

<form method="post">
    <input type="hidden" asp-for="movieId">
    <label asp-for="Title">Title: </label>
    <input asp-for="Title" type="text" placeholder="Title" id="Title" required>
    <br>
    <label asp-for="Rating">Rating: </label>
    <select asp-for="Rating" type="text" placeholder="Rating" id="Rating">
        <option value="">Select a Rating</option>
        <option value="G">G</option>
        <option value="PG">PG</option>
        <option value="PG-13">PG-13</option>
        <option value="R">R</option>
        <option value="NR">NR</option>
    </select>
    <br>
    <label asp-for="CategoryId">Category: </label>
    <select asp-for="CategoryId">
        <option value="">Select a Category</option>
        @foreach (Category x in ViewBag.Categories)
        {
            <option value="@x.CategoryId">@x.CategoryName</option>
        }
    </select>
    <br>
    <label asp-for="Year">Year: </label>
    <input asp-for="Year" type="number" placeholder="Year" id="Year" min="1888" required>
    <br>
    <label asp-for="Director">Director: </label>
    <input asp-for="Director" type="text" placeholder="Director" id="Director">
    <br>
    <label asp-for="Edited">Edited?: </label>
    <select asp-for="Edited" required>
        <option value="True">Yes</option>
        <option value="False">No</option>
    </select>
    <br>
    <label asp-for="CopiedToPlex">Copied to Plex?: </label>
    <select asp-for="CopiedToPlex" required>
        <option value="True">Yes</option>
        <option value="False">No</option>
    </select>
    <br/>
    <label asp-for="LentTo">Lent To: </label>
    <input asp-for="LentTo" type="text" placeholder="Lent_to" id="Lent">
    <br>
    <label asp-for="Notes">Notes: </label>
    <input asp-for="Notes" type="text" placeholder="Notes" maxlength="25">

    <button type="submit">Submit</button>
</form>